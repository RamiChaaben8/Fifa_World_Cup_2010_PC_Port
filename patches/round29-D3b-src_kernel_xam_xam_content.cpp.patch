diff --git a/src/kernel/xam/xam_content.cpp b/src/kernel/xam/xam_content.cpp
--- a/src/kernel/xam/xam_content.cpp
+++ b/src/kernel/xam/xam_content.cpp
@@ -18,6 +18,7 @@
 #include <rex/string.h>
 #include <rex/system/kernel_state.h>
 #include <rex/system/xam/content_device.h>
+#include <rex/system/xam/content_manager.h>
 #include <rex/system/xenumerator.h>
 #include <rex/system/xtypes.h>
 
@@ -34,6 +35,18 @@
 #define R28C_LOG(...) do { } while (0)
 #endif
 
+// ROUND29_HUNK_D off switch: compile with -DROUND29_HUNK_D=0 to remove the
+// Round-29 XUID shim (recovery of a 64-bit guest argument truncated by the
+// host argument marshaller) and its tracing.
+#ifndef ROUND29_HUNK_D
+#define ROUND29_HUNK_D 1
+#endif
+#if ROUND29_HUNK_D
+#define R29D_LOG(...) REXKRNL_INFO("ROUND29D " __VA_ARGS__)
+#else
+#define R29D_LOG(...) do { } while (0)
+#endif
+
 namespace rex {
 namespace kernel {
 namespace xam {
@@ -87,6 +100,11 @@
   }
 
   uint64_t xuid = REX_KERNEL_STATE()->user_profile()->xuid();
+  // Round 29: profile-derived, so the shim is normally a no-op here; it is
+  // applied (and logged) so that every content path reports the XUID it used.
+  xuid = rex::system::xam::Round29ResolveXuid(xuid, "create-enumerator");
+  R29D_LOG("XamContentCreateEnumerator caller=0x{:08X} xuid={:016X} (profile-derived)",
+           rex::system::xam::Round29GuestCallerLr(), xuid);
 
   auto e = make_object<XStaticEnumerator<XCONTENT_DATA>>(REX_KERNEL_STATE(), items_per_enumerate);
   auto result = e->Initialize(0xFF, 0xFE, 0x20005, 0x20007, 0);
@@ -149,6 +167,20 @@
   if (content_data.content_type == XContentType::kMarketplaceContent) {
     xuid = 0;
   }
+
+  // Round 29: content_data.xuid is read from guest memory (it is therefore NOT
+  // affected by the argument marshaller), but normalise it anyway so the header
+  // written by the create path and the enumerator agree on one XUID.
+  if (content_data.content_type != XContentType::kMarketplaceContent) {
+    const uint64_t requested_content_xuid = uint64_t(content_data.xuid);
+    const uint64_t resolved_content_xuid =
+        rex::system::xam::Round29ResolveXuid(requested_content_xuid, "content-create-data");
+    if (resolved_content_xuid != requested_content_xuid) {
+      content_data.xuid = resolved_content_xuid;
+    }
+  }
+  R29D_LOG("xeXamContentCreate caller=0x{:08X} content_xuid={:016X} create_xuid={:016X}",
+           rex::system::xam::Round29GuestCallerLr(), uint64_t(content_data.xuid), xuid);
 
   R28C_LOG("xeXamContentCreate root='{}' flags={:08X} size={} type={:08X} title_id={:08X} "
            "xuid={:016X} resolved_xuid={:016X}",
