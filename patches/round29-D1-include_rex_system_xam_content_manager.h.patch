+// ---------------------------------------------------------------------------
+// Round 29 diagnostics (FIFA World Cup 2010 save / XUID investigation).
+// ---------------------------------------------------------------------------
+
+// The guest LR of the current export entry (i.e. the guest call site), or 0
+// when no guest thread is bound to the calling thread.
+uint32_t Round29GuestCallerLr();
+
+// ReXGlue's guest->host argument marshaller reads a 64-bit integer argument
+// from the *low 32 bits* of the argument register only, so a guest XUID passed
+// as a function argument arrives at the export as 0x00000000<low 32 bits>:
+//
+//   include/rex/ppc/function.h
+//   ArgTranslator::GetIntegerArgumentValue() -> `return ctx.r3.u32;` etc.
+//
+// When |requested| has a zero upper 32 bits and its low 32 bits equal the
+// current profile XUID's low 32 bits, this returns the full profile XUID;
+// otherwise |requested| is returned unchanged.  Every call is logged, and
+// substitutions can be disabled with the `round29_xuid_shim` cvar.
+// Compiled out with -DROUND29_HUNK_D=0.
+uint64_t Round29ResolveXuid(uint64_t requested, const char* site);
+
 
