+      std::array<uint8_t, 4> output = {0x5A, 0x5A, 0x5A, 0x5A};
+      auto expected = output;
+      for (size_t bit = offset; bit < offset + length; ++bit) {
+        const uint8_t mask = uint8_t(1u << (7 - (bit & 7)));
+        expected[bit / 8] = uint8_t((expected[bit / 8] & ~mask) | (source[bit / 8] & mask));
+      }
+      BitStream stream(source.data(), 24);
+      stream.SetOffset(offset);
+      REQUIRE(stream.Copy(output.data(), length) == offset);
+      REQUIRE(output == expected);
+      REQUIRE(stream.offset_bits() == offset + length);
+    }
+  }
+}
+
+TEST_CASE("ByteStream rejects overflow and truncated strings in Release", "[stream][bytestream]") {
+  std::array<uint8_t, 8> buffer{};
+  ByteStream stream(buffer.data(), buffer.size());
+  SECTION("Advance overflow") {
+    stream.Advance(1);
+    REQUIRE_THROWS_AS(stream.Advance(std::numeric_limits<size_t>::max()), std::out_of_range);
+    CHECK(stream.offset() == 1);
+  }
+  SECTION("Read outside buffer") {
+    stream.set_offset(buffer.size());
+    REQUIRE_THROWS_AS(stream.Read<uint32_t>(), std::out_of_range);
+    CHECK(stream.offset() == buffer.size());
+  }
+  SECTION("Write outside buffer") {
+    stream.set_offset(buffer.size());
+    REQUIRE_THROWS_AS(stream.Write(uint32_t(42)), std::out_of_range);
+    CHECK(buffer == std::array<uint8_t, 8>{});
+  }
+  SECTION("Truncated string length") {
+    stream.Write(uint32_t(0xFFFFFFFFu));
+    stream.set_offset(0);
+    REQUIRE_THROWS_AS(stream.Read<std::string>(), std::out_of_range);
+    stream.set_offset(0);
+    REQUIRE_THROWS_AS(stream.Read<std::u16string>(), std::out_of_range);
+  }
+}
diff --git a/tests/unit/system/function_dispatcher_test.cpp b/tests/unit/system/function_dispatcher_test.cpp
index 88617f2..142d5b9 100644
--- a/tests/unit/system/function_dispatcher_test.cpp
+++ b/tests/unit/system/function_dispatcher_test.cpp
@@ -278,3 +278,59 @@ TEST_CASE("PPCContext: restoring a zeroed fpscr leaves host FP exception masks i
   CHECK((ctx.fpscr.getcsr() & ~kGuestMask) == (host_before & ~kGuestMask));
   CHECK(ctx.fpscr.csr == ctx.fpscr.getcsr());
 }
+
+
+namespace {
+void ThrowingDispatchFn(PPCContext& ctx, uint8_t*) {
+  ctx.r1.u64 -= 32;
+  ctx.lr = 0;
+  ctx.r14.u64 = 0;
+  throw 42;
+}
+}
+
+TEST_CASE("FunctionDispatcher: invalid ranges and unaligned functions are rejected",
+          "[runtime][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(0xFFFFFF00u, 0x10000u,
+                                                 0xFFFFFF00u, 0x100000u));
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(0x8B000001u, 0x10000u,
+                                                 0x8B000000u, 0x100000u));
+  REQUIRE(dispatcher.InitializeFunctionTable(0x8B000000u, 0x10000u,
+                                              0x8B000000u, 0x100000u));
+  CHECK_FALSE(dispatcher.SetFunction(0x8B000001u, &DummyFn));
+  CHECK(dispatcher.GetFunction(0x8B000001u) == nullptr);
+  REQUIRE(dispatcher.SetFunction(0x8B000000u, &DummyFn));
+  CHECK(dispatcher.GetFunction(0x8B000000u) == &DummyFn);
+}
+
+TEST_CASE("FunctionDispatcher: exceptions restore dispatch and trap state",
+          "[runtime][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+  constexpr uint32_t base = 0x8A000000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(base, 0x10000u, base, 0x100000u));
+  REQUIRE(dispatcher.SetFunction(base + 0x40, &ThrowingDispatchFn));
+  rex::runtime::ThreadState previous(1, 0x71000000u, 0x60000000u, &memory);
+  rex::runtime::ThreadState target(2, 0x70000000u, 0x60000000u, &memory);
+  auto* ctx = target.context();
+  ctx->lr = 0x12345678u;
+  ctx->r14.u64 = 0x14141414u;
+  rex::runtime::ThreadState::Bind(&previous);
+  SECTION("Execute") {
+    uint64_t args[] = {0};
+    REQUIRE_THROWS_AS(dispatcher.Execute(&target, base + 0x40, args, 1), int);
+  }
+  SECTION("ExecuteTrap") {
+    uint64_t args[] = {0};
+    REQUIRE_THROWS_AS(dispatcher.ExecuteTrap(&target, base + 0x40, args, 1), int);
+    CHECK(ctx->r14.u64 == 0x14141414u);
+  }
+  CHECK(ctx->r1.u64 == 0x70000000u);
+  CHECK(ctx->lr == 0x12345678u);
+  CHECK(rex::runtime::ThreadState::Get() == &previous);
+  rex::runtime::ThreadState::Bind(nullptr);
+}
