+u32 NetDll_getsockname_entry(u32 caller, u32 socket_handle,
+                             ppc_ptr_t<XSOCKADDR_IN> name,
+                             mapped_u32 namelen_ptr) {
+  if (!name || !namelen_ptr) {
+    // WSAEFAULT
+    XThread::SetLastError(0x271E);
+    return -1;
+  }
+
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    // WSAENOTSOCK
+    XThread::SetLastError(0x2736);
+    return -1;
+  }
+
+  N_XSOCKADDR_IN native_name = {};
+
+#if REX_PLATFORM_WIN32
+  int native_len = sizeof(native_name);
+  int ret = ::getsockname(
+      static_cast<SOCKET>(socket->native_handle()),
+      reinterpret_cast<sockaddr*>(&native_name),
+      &native_len);
+#else
+  socklen_t native_len = sizeof(native_name);
+  int ret = ::getsockname(
+      static_cast<int>(socket->native_handle()),
+      reinterpret_cast<sockaddr*>(&native_name),
+      &native_len);
+#endif
+
+  if (ret == -1) {
+#if REX_PLATFORM_WIN32
+    XThread::SetLastError(WSAGetLastError());
+#else
+    XThread::SetLastError(0);
+#endif
+    return -1;
+  }
+
+  name->sin_family = native_name.sin_family;
+  name->sin_port = native_name.sin_port;
+  name->sin_addr = native_name.sin_addr;
+  std::memset(name->x_sin_zero, 0, sizeof(name->x_sin_zero));
+
+  *namelen_ptr = static_cast<uint32_t>(native_len);
+
+  REXKRNL_INFO(
+      "[ONLINE] NetDll_getsockname socket={} name=0x{:08X} lenptr=0x{:08X} family={} port={} len={}",
+      socket_handle,
+      name.guest_address(),
+      namelen_ptr.guest_address(),
+      native_name.sin_family,
+      ntohs(static_cast<uint16_t>(native_name.sin_port)),
+      static_cast<uint32_t>(native_len));
+
+  return 0;
+}
