+// "last swap + interval", with the interval taken from bits 8..11 of its argument. Capping it here changes
+// how often frames are displayed and nothing else; the game's own frame pacing follows the display.
+constexpr uint32_t kFifaStreetSwapCallback = 0x8270F040;
