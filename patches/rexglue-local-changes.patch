diff --git a/include/rex/ppc/gprlr_inline.h b/include/rex/ppc/gprlr_inline.h
new file mode 100644
index 0000000..4506ec2
--- /dev/null
+++ b/include/rex/ppc/gprlr_inline.h
@@ -0,0 +1,72 @@
+/**
+ * @file        gprlr_inline.h
+ * @brief       Inline copies of the compiler's GPR/LR save and restore helpers
+ *
+ * The Xbox 360 compiler calls __savegprlr_N / __restgprlr_N (N = 14..31) from almost every
+ * non-leaf function. Recompiled as ordinary functions they are out-of-line weak calls carrying a
+ * PPCContext reference. Codegen emits calls to these always_inline copies instead; the bodies are
+ * the exact ones the helpers are recompiled to (r1 - 8 * (32 - i) - 8 for each register i, then the
+ * link register word at r1 - 8).
+ *
+ * Requires REX_LOAD_U32/U64, REX_STORE_U32/U64 and PPCContext from the module's pch.
+ */
+#pragma once
+
+#define REX_INL_SV(i) REX_STORE_U64(ctx.r1.u32 + (-8 * (32 - i) - 8), ctx.r##i.u64);
+#define REX_INL_RS(i) ctx.r##i.u64 = REX_LOAD_U64(ctx.r1.u32 + (-8 * (32 - i) - 8));
+
+#define REX_INL_SAVE_31 REX_INL_SV(31)
+#define REX_INL_SAVE_30 REX_INL_SV(30) REX_INL_SAVE_31
+#define REX_INL_SAVE_29 REX_INL_SV(29) REX_INL_SAVE_30
+#define REX_INL_SAVE_28 REX_INL_SV(28) REX_INL_SAVE_29
+#define REX_INL_SAVE_27 REX_INL_SV(27) REX_INL_SAVE_28
+#define REX_INL_SAVE_26 REX_INL_SV(26) REX_INL_SAVE_27
+#define REX_INL_SAVE_25 REX_INL_SV(25) REX_INL_SAVE_26
+#define REX_INL_SAVE_24 REX_INL_SV(24) REX_INL_SAVE_25
+#define REX_INL_SAVE_23 REX_INL_SV(23) REX_INL_SAVE_24
+#define REX_INL_SAVE_22 REX_INL_SV(22) REX_INL_SAVE_23
+#define REX_INL_SAVE_21 REX_INL_SV(21) REX_INL_SAVE_22
+#define REX_INL_SAVE_20 REX_INL_SV(20) REX_INL_SAVE_21
+#define REX_INL_SAVE_19 REX_INL_SV(19) REX_INL_SAVE_20
+#define REX_INL_SAVE_18 REX_INL_SV(18) REX_INL_SAVE_19
+#define REX_INL_SAVE_17 REX_INL_SV(17) REX_INL_SAVE_18
+#define REX_INL_SAVE_16 REX_INL_SV(16) REX_INL_SAVE_17
+#define REX_INL_SAVE_15 REX_INL_SV(15) REX_INL_SAVE_16
+#define REX_INL_SAVE_14 REX_INL_SV(14) REX_INL_SAVE_15
+
+#define REX_INL_REST_31 REX_INL_RS(31)
+#define REX_INL_REST_30 REX_INL_RS(30) REX_INL_REST_31
+#define REX_INL_REST_29 REX_INL_RS(29) REX_INL_REST_30
+#define REX_INL_REST_28 REX_INL_RS(28) REX_INL_REST_29
+#define REX_INL_REST_27 REX_INL_RS(27) REX_INL_REST_28
+#define REX_INL_REST_26 REX_INL_RS(26) REX_INL_REST_27
+#define REX_INL_REST_25 REX_INL_RS(25) REX_INL_REST_26
+#define REX_INL_REST_24 REX_INL_RS(24) REX_INL_REST_25
+#define REX_INL_REST_23 REX_INL_RS(23) REX_INL_REST_24
+#define REX_INL_REST_22 REX_INL_RS(22) REX_INL_REST_23
+#define REX_INL_REST_21 REX_INL_RS(21) REX_INL_REST_22
+#define REX_INL_REST_20 REX_INL_RS(20) REX_INL_REST_21
+#define REX_INL_REST_19 REX_INL_RS(19) REX_INL_REST_20
+#define REX_INL_REST_18 REX_INL_RS(18) REX_INL_REST_19
+#define REX_INL_REST_17 REX_INL_RS(17) REX_INL_REST_18
+#define REX_INL_REST_16 REX_INL_RS(16) REX_INL_REST_17
+#define REX_INL_REST_15 REX_INL_RS(15) REX_INL_REST_16
+#define REX_INL_REST_14 REX_INL_RS(14) REX_INL_REST_15
+
+#define REX_INL_GPRLR(N)                                                                      \
+  static inline __attribute__((always_inline)) void rex_inl_savegprlr_##N(                   \
+      PPCContext& __restrict ctx, uint8_t* base) {                                           \
+    REX_INL_SAVE_##N                                                                         \
+    REX_STORE_U32(ctx.r1.u32 + -8, ctx.r12.u32);                                             \
+  }                                                                                          \
+  static inline __attribute__((always_inline)) void rex_inl_restgprlr_##N(                   \
+      PPCContext& __restrict ctx, uint8_t* base) {                                           \
+    REX_INL_REST_##N                                                                         \
+    ctx.r12.u64 = REX_LOAD_U32(ctx.r1.u32 + -8);                                             \
+    ctx.lr = ctx.r12.u64;                                                                    \
+  }
+
+REX_INL_GPRLR(14) REX_INL_GPRLR(15) REX_INL_GPRLR(16) REX_INL_GPRLR(17) REX_INL_GPRLR(18)
+REX_INL_GPRLR(19) REX_INL_GPRLR(20) REX_INL_GPRLR(21) REX_INL_GPRLR(22) REX_INL_GPRLR(23)
+REX_INL_GPRLR(24) REX_INL_GPRLR(25) REX_INL_GPRLR(26) REX_INL_GPRLR(27) REX_INL_GPRLR(28)
+REX_INL_GPRLR(29) REX_INL_GPRLR(30) REX_INL_GPRLR(31)
