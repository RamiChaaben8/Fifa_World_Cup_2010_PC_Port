+// Optional global frame limit applied where the game's swap is executed. REX_FPS_LIMIT_HZ=<Hz>|auto
+// ("auto" follows REX_VIDEO_MODE_REFRESH_RATE). It caps every scene, including logos and menus, at the
+// chosen refresh rate when host VSync is off; unset or 0 leaves the frame rate alone.
+double FrameLimitHz() {
+  static const double hz = [] {
+    const char* value = std::getenv("REX_FPS_LIMIT_HZ");
+    if (value && std::strcmp(value, "auto") == 0) value = std::getenv("REX_VIDEO_MODE_REFRESH_RATE");
+    const double parsed = value ? std::strtod(value, nullptr) : 0.0;
+    return parsed >= 20.0 && parsed <= 1000.0 ? parsed : 0.0;
+  }();
+  return hz;
