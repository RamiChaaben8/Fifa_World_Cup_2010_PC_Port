+    std::filesystem::path dir;
+    if (const char* env = std::getenv("FIFASTREET_MODS"); env && *env) {
+      dir = env;
+    } else {
+      dir = rex::filesystem::GetExecutableFolder().parent_path() / "Mods";
+    }
