+// True VSync (REX_TRUE_VSYNC=1): hold the game's render thread to the chosen refresh rate at its own
+// swap, so the game runs at exactly the display rate. Pacing in the swap callback instead slowed videos/audio.
+static void PaceTrueVsyncSwap() {
+  using Clock = std::chrono::steady_clock;
+  static const double hz = [] {
+    const char* on = std::getenv("REX_TRUE_VSYNC");
+    if (!on || on[0] != '1') return 0.0;
+    // REX_TRUE_VSYNC_FPS: displayed frame rate when it is a divisor of the refresh rate (30 at 60 Hz).
+    const char* value = std::getenv("REX_TRUE_VSYNC_FPS");
+    if (!value) value = std::getenv("REX_VIDEO_MODE_REFRESH_RATE");
+    const double parsed = value ? std::strtod(value, nullptr) : 0.0;
+    if (parsed < 20.0 || parsed > 1000.0) return 0.0;
+    // Default ("newest"): the game runs on its own clock and each refresh shows its newest frame; the game
+    // simulates on a separate thread, so holding rendering to the display made motion uneven. It is only
+    // capped at twice the displayed rate so a fresh frame is always ready without wasting power.
+    // REX_TRUE_VSYNC_MODE=locked: rendering held to the display (smooth only if the game's clock agrees).
+    const char* mode = std::getenv("REX_TRUE_VSYNC_MODE");
+    return (mode && std::strcmp(mode, "locked") == 0) ? parsed : -parsed * 2.0;
+  }();
+  if (hz == 0.0) return;
+  const bool locked = hz > 0.0;
+  const double rate = locked ? hz : -hz;
+#if REX_PLATFORM_WIN32
+  // D3D12 publishes its swap chain latency waitable: waiting on it clocks the game by the real display
+  // refresh (no drift against a CPU timer, so no skipped or doubled frames). The timer below then only
+  // stops the game from outrunning the chosen rate on a faster monitor.
+  char handle_text[32];
+  const bool display_paced =
+      locked && GetEnvironmentVariableA("REX_TRUE_VSYNC_WAITABLE", handle_text, sizeof(handle_text)) > 0;
+  if (display_paced) {
+    const HANDLE waitable = HANDLE(uintptr_t(std::strtoull(handle_text, nullptr, 16)));
+    // Presents that are not game frames (window repaints) also release the semaphore: take every pending
+    // release at once (no surplus builds up, so the game never runs ahead of the display and drops frames),
+    // and only wait when the display has not taken a frame since the last swap.
+    int released = 0;
+    while (WaitForSingleObject(waitable, 0) == WAIT_OBJECT_0) ++released;
+    if (released == 0) WaitForSingleObject(waitable, 100);
+  }
+#else
+  const bool display_paced = false;
+#endif
+  static Clock::time_point next{};
+  const auto period = std::chrono::duration_cast<Clock::duration>(
+      std::chrono::duration<double>(1.0 / (display_paced ? rate * 1.05 : rate)));
+  auto now = Clock::now();
+  if (next == Clock::time_point{} || now - next > period * 2) next = now;  // late or first: no catch-up burst
+  if (now < next) {
+    if (next - now > std::chrono::milliseconds(2)) std::this_thread::sleep_for(next - now - std::chrono::milliseconds(1));
+    while (Clock::now() < next) std::this_thread::yield();
+  }
+  next += period;
+}
