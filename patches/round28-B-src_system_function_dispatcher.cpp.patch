+uint32_t FunctionDispatcher::FindContainingFunctionStart(uint32_t guest_address) {
+  std::lock_guard<std::recursive_mutex> lock(dispatch_mutex_);
+  std::vector<uint32_t> starts;
+  starts.reserve(function_table_.size());
+  for (const auto& entry : function_table_) {
+    starts.push_back(entry.first);
+  }
+  if (starts.empty()) {
+    return 0;
+  }
+  std::sort(starts.begin(), starts.end());
+  auto it = std::upper_bound(starts.begin(), starts.end(), guest_address);
+  if (it == starts.begin()) {
+    return 0;
+  }
+  return *std::prev(it);
+}
