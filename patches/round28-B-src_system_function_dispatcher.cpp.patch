+#if ROUND28_HUNK_B
+// Dumps 64 bytes of guest memory at `guest`, but only after confirming the region
+// is committed, so the fatal path cannot take a second fault while reporting.
+void Round28DumpBytes(::rex::memory::Memory* mem, const char* tag, uint32_t guest) {
+  if (!mem) {
+    REXCPU_ERROR("    [{}] 0x{:08X} (no memory object)", tag, guest);
+    return;
+  }
+  auto* heap = mem->LookupHeap(guest);
+  ::rex::memory::HeapAllocationInfo info{};
+  const bool committed = heap && heap->QueryRegionInfo(guest, &info) &&
+                         (info.state & ::rex::memory::kMemoryAllocationCommit);
+  if (!committed) {
+    REXCPU_ERROR("    [{}] 0x{:08X} (page not committed; not dumped)", tag, guest);
+    return;
+  }
+  const uint8_t* p = mem->TranslateVirtual(guest);
+  const uint32_t n = 64;
+  std::string text;
+  for (uint32_t i = 0; i < n; i += 16) {
+    text += fmt::format("      {:08X}: ", guest + i);
+    for (uint32_t j = 0; j < 16; ++j) text += fmt::format("{:02X} ", p[i + j]);
+    text += " ";
+    for (uint32_t j = 0; j < 16; ++j) {
+      const uint8_t c = p[i + j];
+      text += (c >= 0x20 && c < 0x7F) ? static_cast<char>(c) : '.';
+    }
+    if (i + 16 < n) text += "\n";
+  }
+  REXCPU_ERROR("    [{}] 0x{:08X}\n{}", tag, guest, text);
+}
+
+// Dumps `tag` (a register value) and, when that location is committed, the
+// pointer stored there and the 64 bytes it points at.
+void Round28DumpRegAndPointee(::rex::memory::Memory* mem, const char* tag, uint32_t value) {
+  Round28DumpBytes(mem, tag, value);
+  auto* heap = mem ? mem->LookupHeap(value) : nullptr;
+  ::rex::memory::HeapAllocationInfo info{};
+  if (value && heap && heap->QueryRegionInfo(value, &info) &&
+      (info.state & ::rex::memory::kMemoryAllocationCommit)) {
+    const uint8_t* p = mem->TranslateVirtual(value);
+    const uint32_t pointee =
+        (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+    Round28DumpBytes(mem, (std::string(tag) + "->*").c_str(), pointee);
+  }
+}
+#endif  // ROUND28_HUNK_B
 
