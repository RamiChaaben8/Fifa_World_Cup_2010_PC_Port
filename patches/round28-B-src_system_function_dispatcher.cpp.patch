+#if ROUND28_HUNK_B
+void Round28DumpGuestContext(PPCContext& ctx, const char* why) {
+  FunctionDispatcher* dispatcher = GetBoundFunctionDispatcher();
+  ::rex::memory::Memory* mem = dispatcher ? dispatcher->memory() : nullptr;
+  const uint32_t lr = static_cast<uint32_t>(ctx.lr);
+
+  PPCRegister* gprs[32] = {
+      &ctx.r0,  &ctx.r1,  &ctx.r2,  &ctx.r3,  &ctx.r4,  &ctx.r5,  &ctx.r6,  &ctx.r7,
+      &ctx.r8,  &ctx.r9,  &ctx.r10, &ctx.r11, &ctx.r12, &ctx.r13, &ctx.r14, &ctx.r15,
+      &ctx.r16, &ctx.r17, &ctx.r18, &ctx.r19, &ctx.r20, &ctx.r21, &ctx.r22, &ctx.r23,
+      &ctx.r24, &ctx.r25, &ctx.r26, &ctx.r27, &ctx.r28, &ctx.r29, &ctx.r30, &ctx.r31};
+  std::string gpr;
+  for (int i = 0; i < 32; ++i) {
+    gpr += fmt::format("r{}={:08X} ", i, static_cast<uint32_t>(gprs[i]->u64));
+    if ((i & 7) == 7 && i != 31) gpr += "\n    ";
+  }
+  REXCPU_ERROR("ROUND28 guest context ({})\n    {}\n    LR={:08X} CTR={:08X}", why, gpr, lr,
+               static_cast<uint32_t>(ctx.ctr.u64));
+
+  if (dispatcher) {
+    const uint32_t start = dispatcher->FindContainingFunctionStart(lr);
+    const uint32_t module = dispatcher->FindCallerModuleBase(lr);
+    REXCPU_ERROR(
+        "ROUND28 LR nearest registered function 0x{:08X} (+0x{:X}); module code base 0x{:08X}"
+        "{}",
+        start, lr - start, module,
+        (start == 0 || (lr - start) > 0x40000)
+            ? fmt::format(" [WARNING nearest-lower is not proof of containment, +0x{:X}]",
+                          lr - start)
+            : std::string());
+  } else {
+    REXCPU_ERROR("ROUND28 LR function: dispatcher unavailable");
+  }
+
+  Round28DumpRegAndPointee(mem, "r3", static_cast<uint32_t>(ctx.r3.u64));
+  Round28DumpRegAndPointee(mem, "r8", static_cast<uint32_t>(ctx.r8.u64));
+  Round28DumpRegAndPointee(mem, "r9", static_cast<uint32_t>(ctx.r9.u64));
+  Round28DumpRegAndPointee(mem, "r11", static_cast<uint32_t>(ctx.r11.u64));
+  Round28DumpRegAndPointee(mem, "r30", static_cast<uint32_t>(ctx.r30.u64));
+  Round28DumpRegAndPointee(mem, "r31", static_cast<uint32_t>(ctx.r31.u64));
+}
+#endif  // ROUND28_HUNK_B
 
