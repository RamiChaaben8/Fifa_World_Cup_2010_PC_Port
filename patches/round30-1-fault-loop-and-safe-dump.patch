+#if defined(_WIN32)
+// MiniDumpWriteDump IO callback: aborts the dump once it exceeds the cap.
+struct Round30DumpLimit {
+  uint64_t written = 0;
+  uint64_t cap = 0;
+};
+BOOL CALLBACK Round30DumpIoCallback(void* param, const PMINIDUMP_CALLBACK_INPUT input,
+                                    PMINIDUMP_CALLBACK_OUTPUT output) {
+  auto* limit = static_cast<Round30DumpLimit*>(param);
+  if (!limit || !input || !output) {
+    return FALSE;
+  }
+  switch (input->CallbackType) {
+    case IoStartCallback:
+      limit->written = 0;
+      return TRUE;
+    case IoWriteAllCallback:
+      limit->written += input->Io.BufferBytes;
+      if (limit->cap && limit->written > limit->cap) {
+        // Ask dbghelp to stop.  dbghelp may still finish the write, so the file
+        // size is checked again after MiniDumpWriteDump returns.
+        output->Cancel = TRUE;
+      }
+      return TRUE;
+    default:
+      return TRUE;
+  }
+}
+#endif
