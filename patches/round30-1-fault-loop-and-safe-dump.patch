+// ---------------------------------------------------------------------------
+// ROUND30_FIX off switch: compile with -DROUND30_FIX=0 to restore the exact
+// Round-28 behaviour.  With it on, the access-violation dump can no longer fault
+// itself and the diagnostic cannot loop:
+//   (a) every dump checks *host* page protection before reading guest memory
+//       (the low 64 KiB is committed PAGE_NOACCESS, so the Round-28 dump's own
+//       read of guest 5 faulted inside the vectored exception handler; Windows
+//       re-entered the handler and the fault repeated 14,284 times);
+//   (b) the same guest register context seen three times in a row on one thread
+//       is reported as a stuck diagnostic and the process is terminated instead
+//       of recursing until the 16 MiB thread stack is exhausted;
+//   (c) duplicate context blocks are rate-limited after the third repeat;
+//   (d) the guest code bytes around LR are included, because LR is the last
+//       call's return address, not the faulting instruction;
+//   (e) the owner chain and its table pointers (r3 -> table, r8, r29, r31) are
+//       dumped.
+//   (f) Round 31: also dump G = *(r29+0x2C) (the getter's return), *(G+0x1C)
+//       and the first words of the objects G points at; the minidump goes to a
+//       cvar-chosen directory with a size cap and a free-space check.
+// ROUND30_MINIDUMP writes a minidump before the fault-loop termination.
+// ---------------------------------------------------------------------------
+#ifndef ROUND30_FIX
+#define ROUND30_FIX 1
+#endif
+#ifndef ROUND30_MINIDUMP
+#define ROUND30_MINIDUMP 1
+#endif
+
+#if ROUND30_FIX
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+#if ROUND30_MINIDUMP && defined(_WIN32)
+#include <dbghelp.h>
+#pragma comment(lib, "dbghelp.lib")
+#endif
+#endif
