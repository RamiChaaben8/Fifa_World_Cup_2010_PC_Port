+#if ROUND28_HUNK_B && ROUND30_FIX
+// Round 30.  A committed guest page is not necessarily readable: Memory::Initialize
+// commits the low 64 KiB with kMemoryProtectNoAccess (protect_zero), so the Round-28
+// dump's own read of guest address 5 faulted *inside* the vectored exception handler.
+// Every diagnostic read below is therefore conditional on host page protection.
+bool Round30HostReadable(const void* host, size_t length) {
+#if defined(_WIN32)
+  uintptr_t p = reinterpret_cast<uintptr_t>(host);
+  const uintptr_t end = p + length;
+  if (end < p) {
+    return false;
+  }
+  while (p < end) {
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (::VirtualQuery(reinterpret_cast<const void*>(p), &mbi, sizeof(mbi)) != sizeof(mbi)) {
+      return false;
+    }
+    if (mbi.State != MEM_COMMIT) {
+      return false;
+    }
+    if ((mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+      return false;
+    }
+    const uintptr_t region_end = reinterpret_cast<uintptr_t>(mbi.BaseAddress) + mbi.RegionSize;
+    if (region_end <= p) {
+      return false;
+    }
+    p = region_end;
+  }
+  return true;
+#else
+  (void)host;
+  (void)length;
+  return false;
+#endif
+}
+
+bool Round30ReadU32(::rex::memory::Memory* mem, uint32_t guest, uint32_t* out) {
+  if (!mem || !out) {
+    return false;
+  }
+  const uint8_t* p = mem->TranslateVirtual(guest);
+  if (!Round30HostReadable(p, sizeof(uint32_t))) {
+    return false;
+  }
+  *out = (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+  return true;
+}
+
+// Hex dump of `count` big-endian words, used for the object/table chain.
+void Round30DumpWords(::rex::memory::Memory* mem, const char* tag, uint32_t guest, uint32_t count) {
+  if (!mem) {
+    return;
+  }
+  const uint32_t bytes = count * 4;
+  const uint8_t* p = mem->TranslateVirtual(guest);
+  if (!Round30HostReadable(p, bytes)) {
+    REXCPU_ERROR("    [{}] 0x{:08X} (host page not readable; not dumped)", tag, guest);
+    return;
+  }
+  std::string text;
+  for (uint32_t i = 0; i < bytes; i += 16) {
+    if (i) {
+      text += "\n";
+    }
+    text += fmt::format("      {:08X}:", guest + i);
+    for (uint32_t j = 0; j < 16 && (i + j) < bytes; j += 4) {
+      text += fmt::format(" {:08X}",
+                          (uint32_t(p[i + j]) << 24) | (uint32_t(p[i + j + 1]) << 16) |
+                              (uint32_t(p[i + j + 2]) << 8) | uint32_t(p[i + j + 3]));
+    }
+  }
+  REXCPU_ERROR("    [{}] 0x{:08X}\n{}", tag, guest, text);
+}
+
+// LR is the return address of the last call, not the instruction that faulted
+// (0x8333915C vs 0x8333916C in worldcup2010_023).  Dump the code around it so the
+// faulting instruction sequence is in the log even without the guest image.
+void Round30DumpCode(::rex::memory::Memory* mem, uint32_t lr) {
+  if (!mem) {
+    return;
+  }
+  const uint32_t start = lr >= 0x10 ? lr - 0x10 : 0;
+  const uint8_t* p = mem->TranslateVirtual(start);
+  if (!Round30HostReadable(p, 0x60)) {
+    REXCPU_ERROR("    [code around LR] 0x{:08X} (host page not readable; not dumped)", start);
+    return;
+  }
+  std::string text;
+  for (uint32_t i = 0; i < 0x60; i += 16) {
+    if (i) {
+      text += "\n";
+    }
+    text += fmt::format("      {:08X}:", start + i);
+    for (uint32_t j = 0; j < 16; j += 4) {
+      text += fmt::format(" {:08X}",
+                          (uint32_t(p[i + j]) << 24) | (uint32_t(p[i + j + 1]) << 16) |
+                              (uint32_t(p[i + j + 2]) << 8) | uint32_t(p[i + j + 3]));
+    }
+  }
+  REXCPU_ERROR("    [code around LR={:08X}]\n{}", lr, text);
+}
