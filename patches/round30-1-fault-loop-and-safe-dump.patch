+void Round30WriteMinidump() {
+#if ROUND30_MINIDUMP && defined(_WIN32)
+  const uint32_t cap_mb = rex::cvar::Query<uint32_t>("round30_minidump_max_mb");
+  const std::string configured = rex::cvar::Query<std::string>("round30_minidump_dir");
+  wchar_t dir[MAX_PATH]{};
+  if (configured.empty()) {
+    wchar_t temp_path[MAX_PATH]{};
+    if (!::GetTempPathW(MAX_PATH, temp_path)) {
+      return;
+    }
+    ::swprintf_s(dir, L"%sworldcup2010_minidumps", temp_path);
+  } else if (::MultiByteToWideChar(CP_UTF8, 0, configured.c_str(), -1, dir, MAX_PATH) <= 0) {
+    return;
+  }
+  if (!dir[0]) {
+    return;
+  }
+  ::CreateDirectoryW(dir, nullptr);  // fine if it already exists
+
+  // Never fill the user's disk with a crash artefact.
+  ULARGE_INTEGER free_bytes{};
+  const uint64_t need = (static_cast<uint64_t>(cap_mb) + 64ull) * 1024ull * 1024ull;
+  if (!::GetDiskFreeSpaceExW(dir, &free_bytes, nullptr, nullptr)) {
+    REXCPU_ERROR("ROUND30 minidump skipped: cannot query free space for the dump directory");
+    return;
+  }
+  if (free_bytes.QuadPart < need) {
+    REXCPU_ERROR("ROUND30 minidump skipped: only {} MiB free, need {} MiB",
+                 free_bytes.QuadPart / (1024ull * 1024ull), need / (1024ull * 1024ull));
+    return;
+  }
+
+  wchar_t path[MAX_PATH]{};
+  ::swprintf_s(path, L"%s\\worldcup2010_r30_%lu_%llu.dmp", dir,
+               static_cast<unsigned long>(::GetCurrentProcessId()),
+               static_cast<unsigned long long>(::GetTickCount64()));
+  HANDLE file = ::CreateFileW(path, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
+                              FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    REXCPU_ERROR("ROUND30 minidump skipped: cannot create the dump file");
+    return;
+  }
+  Round30DumpLimit limit;
+  limit.cap = static_cast<uint64_t>(cap_mb) * 1024ull * 1024ull;
+  MINIDUMP_CALLBACK_INFORMATION callback{};
+  callback.CallbackRoutine = Round30DumpIoCallback;
+  callback.CallbackParam = &limit;
+  // MiniDumpNormal = module list + thread list + thread stacks; no full memory.
+  const BOOL ok = ::MiniDumpWriteDump(::GetCurrentProcess(), ::GetCurrentProcessId(), file,
+                                      MiniDumpNormal, nullptr, nullptr, &callback);
+  LARGE_INTEGER size{};
+  const bool got_size = ::GetFileSizeEx(file, &size) != 0;
+  ::CloseHandle(file);
+  const bool over_cap =
+      limit.cap && got_size && static_cast<uint64_t>(size.QuadPart) > limit.cap;
+  if (!ok || over_cap) {
+    ::DeleteFileW(path);
+    REXCPU_ERROR("ROUND30 minidump abandoned (cap {} MiB, reached {} MiB)", cap_mb,
+                 limit.written / (1024ull * 1024ull));
+    return;
+  }
+  char narrow[MAX_PATH * 3]{};
+  ::WideCharToMultiByte(CP_UTF8, 0, path, -1, narrow, sizeof(narrow), nullptr, nullptr);
+  REXCPU_ERROR("ROUND30 minidump written: {} ({} KiB, cap {} MiB)", narrow,
+               limit.written / 1024ull, cap_mb);
+#endif
+}
