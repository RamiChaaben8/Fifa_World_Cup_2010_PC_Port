+++ b/src/kernel/xam/xam_content_aggregate.cpp
@@ -28,6 +28,17 @@
 namespace xam {
 using namespace rex::system;
 using namespace rex::system::xam;
+
+// ROUND28_HUNK_C off switch: compile with -DROUND28_HUNK_C=0 to remove the
+// Round-28 XAM content/user/UI tracing added for the save investigation.
+#ifndef ROUND28_HUNK_C
+#define ROUND28_HUNK_C 1
+#endif
+#if ROUND28_HUNK_C
+#define R28C_LOG(...) REXKRNL_INFO("ROUND28C " __VA_ARGS__)
+#else
+#define R28C_LOG(...) do { } while (0)
+#endif
 
