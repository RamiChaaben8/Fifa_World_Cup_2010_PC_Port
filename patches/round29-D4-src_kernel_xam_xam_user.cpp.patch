diff --git a/src/kernel/xam/xam_user.cpp b/src/kernel/xam/xam_user.cpp
--- a/src/kernel/xam/xam_user.cpp
+++ b/src/kernel/xam/xam_user.cpp
@@ -22,6 +22,7 @@
 #include <rex/types.h>
 #include <rex/string.h>
 #include <rex/system/kernel_state.h>
+#include <rex/system/xam/content_manager.h>
 #include <rex/system/xam/user_profile.h>
 #include <rex/system/xenumerator.h>
 #include <rex/system/xio.h>
@@ -37,6 +38,18 @@
 #define R28C_LOG(...) REXKRNL_INFO("ROUND28C " __VA_ARGS__)
 #else
 #define R28C_LOG(...) do { } while (0)
+#endif
+
+// ROUND29_HUNK_D off switch: compile with -DROUND29_HUNK_D=0 to remove the
+// Round-29 XUID shim (recovery of a 64-bit guest argument truncated by the
+// host argument marshaller) and its tracing.
+#ifndef ROUND29_HUNK_D
+#define ROUND29_HUNK_D 1
+#endif
+#if ROUND29_HUNK_D
+#define R29D_LOG(...) REXKRNL_INFO("ROUND29D " __VA_ARGS__)
+#else
+#define R29D_LOG(...) do { } while (0)
 #endif
 
 REXCVAR_DEFINE_UINT32(user_language, 1, "Kernel", "User's language ID");
@@ -73,6 +86,34 @@
     result = X_E_INVALIDARG;
   }
   *xuid_ptr = xuid;
+
+  // Round 29: log the value written, the guest caller and the guest address the
+  // guest will read the 64-bit XUID back from.  FIFA reads it with `ld r3,80(r1)`
+  // in sub_8319C5D0 and passes it as arg1 of XamContentAggregateCreateEnumerator.
+  // Logged once per distinct (caller, value, args) so a per-frame poll cannot
+  // flood the log.
+  {
+    const uint32_t r29_lr = rex::system::xam::Round29GuestCallerLr();
+    static bool r29_logged = false;
+    static uint32_t r29_last_lr = 0xFFFFFFFFu;
+    static uint64_t r29_last_xuid = ~uint64_t(0);
+    static uint32_t r29_last_user_index = 0xFFFFFFFFu;
+    static uint32_t r29_last_type_mask = 0xFFFFFFFFu;
+    static uint32_t r29_last_result = 0xFFFFFFFFu;
+    if (!r29_logged || r29_last_lr != r29_lr || r29_last_xuid != xuid ||
+        r29_last_user_index != user_index || r29_last_type_mask != type_mask ||
+        r29_last_result != result) {
+      R29D_LOG("XamUserGetXUID user_index={} type_mask={} -> 0x{:08X} xuid={:016X} "
+               "written_to=0x{:08X} caller=0x{:08X} (guest reads it back with `ld`)",
+               user_index, type_mask, result, xuid, xuid_ptr.guest_address(), r29_lr);
+      r29_logged = true;
+      r29_last_lr = r29_lr;
+      r29_last_xuid = xuid;
+      r29_last_user_index = user_index;
+      r29_last_type_mask = type_mask;
+      r29_last_result = result;
+    }
+  }
   return result;
 }
 
@@ -84,7 +125,23 @@
       signin_state = user_profile->signin_state();
     }
   }
-  R28C_LOG("XamUserGetSigninState user_index={} -> 0x{:08X}", uint32_t(user_index), signin_state);
+  // Round 29: this export is polled every frame (116,936 of the 116,987 ROUND28C
+  // lines in the ~191 s run worldcup2010_021).  Log only when the returned value
+  // changes for a given user index.
+  {
+    static bool r29_logged = false;
+    static uint32_t r29_last_user_index = 0xFFFFFFFFu;
+    static uint32_t r29_last_state = 0xFFFFFFFFu;
+    if (!r29_logged || r29_last_user_index != uint32_t(user_index) ||
+        r29_last_state != signin_state) {
+      R28C_LOG("XamUserGetSigninState user_index={} -> 0x{:08X} (value changed; "
+               "per-call repeat suppressed)",
+               uint32_t(user_index), signin_state);
+      r29_logged = true;
+      r29_last_user_index = uint32_t(user_index);
+      r29_last_state = signin_state;
+    }
+  }
   return signin_state;
 }
 
@@ -112,6 +169,26 @@
   info->xuid = user_profile->xuid();
   info->signin_state = 2; // FIFA Street: report Xbox Live sign-in
   rex::string::copy_truncating(info->name, user_profile->name(), rex::countof(info->name));
+  // Round 29: log the XUID written, the guest caller and the guest struct address.
+  {
+    const uint32_t r29_lr = rex::system::xam::Round29GuestCallerLr();
+    static bool r29_logged = false;
+    static uint32_t r29_last_lr = 0xFFFFFFFFu;
+    static uint64_t r29_last_xuid = ~uint64_t(0);
+    static uint32_t r29_last_user_index = 0xFFFFFFFFu;
+    static uint32_t r29_last_flags = 0xFFFFFFFFu;
+    if (!r29_logged || r29_last_lr != r29_lr || r29_last_xuid != uint64_t(info->xuid) ||
+        r29_last_user_index != user_index || r29_last_flags != flags) {
+      R29D_LOG("XamUserGetSigninInfo user_index={} flags={:08X} -> X_E_SUCCESS xuid={:016X} "
+               "written_to=0x{:08X} caller=0x{:08X}",
+               user_index, flags, uint64_t(info->xuid), info.guest_address(), r29_lr);
+      r29_logged = true;
+      r29_last_lr = r29_lr;
+      r29_last_xuid = uint64_t(info->xuid);
+      r29_last_user_index = user_index;
+      r29_last_flags = flags;
+    }
+  }
   return X_E_SUCCESS;
 }
 
