+// ---------------------------------------------------------------------------
+// Round 29 diagnostics + XUID shim (FIFA World Cup 2010 save investigation).
+// ---------------------------------------------------------------------------
+
+uint32_t Round29GuestCallerLr() {
+#if ROUND29_HUNK_D
+  if (auto* ts = rex::runtime::ThreadState::Get()) {
+    if (auto* ctx = ts->context()) {
+      return static_cast<uint32_t>(ctx->lr);
+    }
+  }
+#endif
+  return 0;
+}
+
+uint64_t Round29ResolveXuid(uint64_t requested, const char* site) {
+#if ROUND29_HUNK_D
+  const uint32_t lr = Round29GuestCallerLr();
+  if (REXCVAR_GET(round29_xuid_shim)) {
+    if (auto* ks = rex::system::kernel_state()) {
+      if (auto* profile = ks->user_profile()) {
+        const uint64_t profile_xuid = profile->xuid();
+        if ((requested >> 32) == 0 && profile_xuid != 0 &&
+            static_cast<uint32_t>(requested) == static_cast<uint32_t>(profile_xuid) &&
+            requested != profile_xuid) {
+          R29D_LOG(
+              "xuid shim[{}]: requested={:016X} -> profile_xuid={:016X} "
+              "(upper 32 bits zero, lower 32 bits match) caller=0x{:08X}",
+              site, requested, profile_xuid, lr);
+          return profile_xuid;
+        }
+      }
+    }
+  }
+  R29D_LOG("xuid shim[{}]: requested={:016X} unchanged caller=0x{:08X}", site, requested, lr);
+#else
+  (void)site;
+#endif
+  return requested;
+}
+
 
