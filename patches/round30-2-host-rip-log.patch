+#if ROUND30_FIX
+// Round 30: report which module contains a host RIP.  The guest LR printed by the
+// Round-28 context dump is the last call's return address, not the faulting
+// instruction, so this line is what distinguishes a fault in recompiled guest code
+// (the main executable) from a fault in the runtime's own diagnostics
+// (rexruntime.dll) - the case that produced the 14,284-iteration fault loop.
+const char* Round30HostRipClass(uint64_t rip, uint64_t* module_base, uint64_t* module_offset) {
+  *module_base = 0;
+  *module_offset = 0;
+  MEMORY_BASIC_INFORMATION mbi{};
+  if (::VirtualQuery(reinterpret_cast<const void*>(rip), &mbi, sizeof(mbi)) != sizeof(mbi) ||
+      !mbi.AllocationBase) {
+    return "unmapped";
+  }
+  static const uintptr_t self_base = [] {
+    HMODULE module = nullptr;
+    ::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                             GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         reinterpret_cast<LPCWSTR>(&ExceptionHandler::Install), &module);
+    return reinterpret_cast<uintptr_t>(module);
+  }();
+  static const uintptr_t exe_base = reinterpret_cast<uintptr_t>(::GetModuleHandleW(nullptr));
+  const uintptr_t base = reinterpret_cast<uintptr_t>(mbi.AllocationBase);
+  *module_base = base;
+  *module_offset = static_cast<uint64_t>(rip) - base;
+  if (base == self_base) {
+    return "rexruntime.dll (runtime/diagnostic code, not guest code)";
+  }
+  if (base == exe_base) {
+    return "main executable (recompiled guest code)";
+  }
+  return "other module";
+}
+#endif
